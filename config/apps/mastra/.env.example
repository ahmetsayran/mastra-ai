# OpenRouter anahtarı (ücretsiz): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Kullanılacak model. Ücretsiz modeller ":free" ile biter.
ASSISTANT_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

# Claude kullanmak isterseniz (ücretli):
# ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=anthropic/claude-sonnet-5-5
