{
  "name": "@onlyjs/mastra",
  "version": "0.0.1",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "private": true,
  "config": {
    "envFile": "../../config/apps/mastra/.env"
  },
  "scripts": {
    "dev": "dotenvx run --quiet -f ../../config/apps/mastra/.env -- mastra dev",
    "build": "dotenvx run --quiet -f ../../config/apps/mastra/.env -- mastra build",
    "start": "dotenvx run --quiet -f ../../config/apps/mastra/.env -- mastra start"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@mastra/core": "1.82.0",
    "@mastra/duckdb": "1.18.0",
    "@mastra/libsql": "1.29.0",
    "@mastra/memory": "1.41.0",
    "@mastra/observability": "1.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.38.0",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
